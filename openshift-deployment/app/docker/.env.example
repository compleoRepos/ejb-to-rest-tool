# ═══════════════════════════════════════════════════════════════
# Compleo EJB Client Modernizer — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs obligatoires
# Usage : cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
COMPLEO_PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Sécurité ──────────────────────────────────────────────────
# Secret JWT (OBLIGATOIRE — générer avec: openssl rand -hex 32)
SESSION_SECRET=
AUTH_STRATEGY=local
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=

# ── Base de données PostgreSQL ─────────────────────────────────
DB_NAME=compleo
DB_USER=compleo
DB_PASSWORD=

# ── Stockage MinIO (S3-compatible) ─────────────────────────────
MINIO_ROOT_USER=compleo
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=compleo-data

# ── SSO / OIDC (optionnel, si AUTH_STRATEGY=oidc) ─────────────
# OIDC_ISSUER_URL=https://sso.example.com/realms/compleo
# OIDC_CLIENT_ID=compleo-app
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback

# ── LDAP (optionnel, si AUTH_STRATEGY=ldap) ────────────────────
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
# LDAP_SEARCH_FILTER=(uid={{username}})
