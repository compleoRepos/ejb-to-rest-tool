<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/ejb-jar_3_1.xsd"
         version="3.1">
    <enterprise-beans>
        <session>
            <ejb-name>ActivationCarteBMCE</ejb-name>
            <home>ma.bmce.monetique.ActivationCarteHome</home>
            <remote>ma.bmce.monetique.ActivationCarteRemote</remote>
            <ejb-class>ma.bmce.monetique.ActivationCarteBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
        </session>
        <session>
            <ejb-name>PaiementCBBMCE</ejb-name>
            <home>ma.bmce.monetique.PaiementCBHome</home>
            <remote>ma.bmce.monetique.PaiementCBRemote</remote>
            <ejb-class>ma.bmce.monetique.PaiementCBBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
        </session>
        <session>
            <ejb-name>OppositionCarteBMCE</ejb-name>
            <home>ma.bmce.monetique.OppositionCarteHome</home>
            <remote>ma.bmce.monetique.OppositionCarteRemote</remote>
            <ejb-class>ma.bmce.monetique.OppositionCarteBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
        </session>
        <session>
            <ejb-name>GestionPINBMCE</ejb-name>
            <home>ma.bmce.monetique.GestionPINHome</home>
            <remote>ma.bmce.monetique.GestionPINRemote</remote>
            <ejb-class>ma.bmce.monetique.GestionPINBean</ejb-class>
            <session-type>Stateful</session-type>
            <transaction-type>Container</transaction-type>
        </session>
    </enterprise-beans>
    <assembly-descriptor>
        <container-transaction>
            <method>
                <ejb-name>ActivationCarteBMCE</ejb-name>
                <method-name>activerCarte</method-name>
            </method>
            <trans-attribute>Required</trans-attribute>
        </container-transaction>
        <container-transaction>
            <method>
                <ejb-name>PaiementCBBMCE</ejb-name>
                <method-name>autoriserPaiement</method-name>
            </method>
            <trans-attribute>Required</trans-attribute>
        </container-transaction>
    </assembly-descriptor>
</ejb-jar>
